<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL and the Maven Central release profile come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-fx</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Parley Files FX</name>
	<description>JavaFX user interface for parley-files: connecting to a file system from its
		connection settings, and (to come) choosing and browsing FileSources.</description>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.files.fx</parley.moduleName>
		<!-- Java 11 like the other Parley modules (from parley-parent): JavaFX 17 LTS runs on 11 -->
		<javafx.version>17.0.20</javafx.version>
	</properties>

	<!-- GitHub Packages, used by release.sh. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/parley-files-fx</url>
		</repository>
	</distributionManagement>

	<build>
		<plugins>
			<!-- Attaches parley-files-fx-<version>-sources.jar. The version comes from parley-parent;
			     package (not deploy) so the source jar is attached BEFORE the deploy plugin runs. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- RecentItemsMenu, which RecentFileMenu is built on -->
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>bringardner-fx-widgets</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- javafx-graphics and javafx-base come with it, for this platform -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.13.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
