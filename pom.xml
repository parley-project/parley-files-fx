<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL and the Maven Central release profile come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-fx</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Parley Files FX</name>
	<description>JavaFX user interface for parley-files: connecting to a file system from its
		connection settings, and (to come) choosing and browsing FileSources.</description>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.files.fx</parley.moduleName>
		<!-- JavaFX 21 needs Java 17; the other Parley modules stay at 11 -->
		<maven.compiler.release>17</maven.compiler.release>
		<javafx.version>21.0.2</javafx.version>
	</properties>

	<!-- GitHub Packages, used by release.sh. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/parley-files-fx</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- javafx-graphics and javafx-base come with it, for this platform -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.13.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
